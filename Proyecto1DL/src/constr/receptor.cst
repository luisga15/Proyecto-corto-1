// ============================================================================
// CONSTRAINTS DEL RECEPTOR  --  Tang Nano 9K (GW1NR-LV9QN88PC6/I5)
// EL-3307 Proyecto corto I   ·   top: top_receptor
//
// Las posiciones de header coinciden con las del transmisor, de modo que el
// enlace de 8 líneas se hace con un cable derecho J5-5..J5-12 -> J5-5..J5-12.
//
// ALIMENTACIÓN DE LA PROTOBOARD:  J6-24 = +3V3   ·   J6-23 = GND
// Los cuatro 74HC86 del receptor se alimentan a 3.3 V (NO a 5 V).
// Las dos tarjetas DEBEN compartir GND.
// ============================================================================

// ---------------------------------------------------------------------------
// ENTRADAS: las 8 líneas que llegan del transmisor
// rx_i[k] = posición k+1 de la palabra recibida; rx_i[7] = bit DED
// Cada línea lleva además una resistencia de pull-down de 10 kohm a GND en la
// protoboard, para que no queden niveles indefinidos si se desconecta el cable.
// ---------------------------------------------------------------------------
IO_LOC  "rx_i[0]" 25;                                               // J5-5  · posición 1 = p1
IO_PORT "rx_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[1]" 26;                                               // J5-6  · posición 2 = p2
IO_PORT "rx_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[2]" 27;                                               // J5-7  · posición 3 = d1
IO_PORT "rx_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[3]" 28;                                               // J5-8  · posición 4 = p4
IO_PORT "rx_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[4]" 29;                                               // J5-9  · posición 5 = d2
IO_PORT "rx_i[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[5]" 30;                                               // J5-10 · posición 6 = d3
IO_PORT "rx_i[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[6]" 33;                                               // J5-11 · posición 7 = d4
IO_PORT "rx_i[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "rx_i[7]" 34;                                               // J5-12 · posición 8 = DED
IO_PORT "rx_i[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// ---------------------------------------------------------------------------
// ENTRADAS: resultados de los circuitos físicos 74HC86 del receptor
// sind_i = síndrome del módulo 7.2  ·  p_total_i = paridad del módulo 7.1
// ---------------------------------------------------------------------------
IO_LOC  "sind_i[0]" 38;                                             // J5-1 · s1
IO_PORT "sind_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "sind_i[1]" 37;                                             // J5-2 · s2
IO_PORT "sind_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "sind_i[2]" 36;                                             // J5-3 · s4
IO_PORT "sind_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "p_total_i" 39;                                             // J5-4 · 1 = paridad impar
IO_PORT "p_total_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// ---------------------------------------------------------------------------
// ENTRADA: conmutador que elige qué muestran los 7 segmentos
// OFF (0) = palabra recibida   ·   ON (1) = posición del bit erróneo
// ---------------------------------------------------------------------------
IO_LOC  "disp_mode_i" 57;                                           // J5-22
IO_PORT "disp_mode_i" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// ---------------------------------------------------------------------------
// SALIDAS: cátodos compartidos por los DOS displays de 7 segmentos
// (activos en bajo, cada uno con su resistencia de 330 ohm)
// ---------------------------------------------------------------------------
IO_LOC  "catodo_o[0]" 41;                                           // J5-15 · segmento a
IO_PORT "catodo_o[0]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[1]" 42;                                           // J5-16 · segmento b
IO_PORT "catodo_o[1]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[2]" 51;                                           // J5-17 · segmento c
IO_PORT "catodo_o[2]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[3]" 53;                                           // J5-18 · segmento d
IO_PORT "catodo_o[3]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[4]" 54;                                           // J5-19 · segmento e
IO_PORT "catodo_o[4]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[5]" 55;                                           // J5-20 · segmento f
IO_PORT "catodo_o[5]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "catodo_o[6]" 56;                                           // J5-21 · segmento g
IO_PORT "catodo_o[6]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------------------------------------------------------------------
// SALIDAS: base de los transistores PNP que encienden cada display
// (activas en bajo: 0 = ese display encendido)
// ---------------------------------------------------------------------------
IO_LOC  "anodo_o[0]" 40;                                            // J5-13 · display de la palabra recibida
IO_PORT "anodo_o[0]" IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC  "anodo_o[1]" 35;                                            // J5-14 · display del síndrome
IO_PORT "anodo_o[1]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------------------------------------------------------------------
// SALIDAS: LEDs de la propia tarjeta (no requieren alambrado externo)
// Son ACTIVOS EN BAJO y están en el banco de 1.8 V.
// led_o = palabra de 4 bits ya corregida  ·  led_ded_o = aviso de doble error
// ---------------------------------------------------------------------------
IO_LOC  "led_o[0]" 10;
IO_PORT "led_o[0]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_o[1]" 11;
IO_PORT "led_o[1]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_o[2]" 13;
IO_PORT "led_o[2]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_o[3]" 14;
IO_PORT "led_o[3]" IO_TYPE=LVCMOS18 DRIVE=8;

IO_LOC  "led_ded_o" 15;
IO_PORT "led_ded_o" IO_TYPE=LVCMOS18 DRIVE=8;
